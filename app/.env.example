# Supabase (Settings → API trong dashboard project GreenLeaf)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Azure Speech Service (dùng chung region với pronunciation-app nếu muốn tái sử dụng key)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Google Gemini (pronunciation feedback)
GEMINI_API_KEY=

# Unsplash (lesson images — free tier: 50 req/hr)
# Get a key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Admin dev chat (/admin/dev-chat) — triggers .github/workflows/admin-request.yml
# Fine-grained PAT with "Actions: read & write" on the repo only.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=phihongthai/GreenLeaf
GITHUB_BASE_BRANCH=main
# Random string; must equal the DEV_CALLBACK_SECRET GitHub Actions secret.
DEV_CALLBACK_SECRET=
